  </dependency>
  <dependency>
    <groupId>fusiondebug.api</groupId>
    <artifactId>server</artifactId>
    <version>1.0.20</version>
    <scope>provided</scope>
  </dependency>

      <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm</artifactId>
      <version>${asm.version}</version>
    </dependency>
     <dependency>
      <groupId>org.ow2.asm</groupId>
