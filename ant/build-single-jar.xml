<?xml version="1.0" encoding="UTF-8"?>
<!--
  LDEV-6711: the part of the build of the single jar that is not done by Maven itself.
  The root pom.xml compiles loader and core into one folder, this file is called (by the antrun plugin of the root pom)
  with that folder as "outputDir" and does what needs a running Lucee or the extension cache:
  - the agent jar
  - the archives (lucee-context.lar, lucee-admin.lar, lucee-doc.lar, testbox.lar) and the json files, created by Lucee itself
  - the bundled extensions, bundles and maven artifacts that are added to the jar
  The properties (rootDir, outputDir, version, dependencies, runtime_classpath ...) are handed over by the root pom.
-->
<project default="archives" basedir="${rootDir}" name="luceeSingleJar">

  <!-- the folder with the compiled classes is the core, the loader and the folder everything gets added to -->
  <property name="core" location="${outputDir}"/>
  <property name="goal" location="${outputDir}"/>
  <property name="trgLoader" location="${target}"/>
  <property name="buildLoaderJar" value="true"/>

  <import file="build-core.xml"/>

  <target name="archives" depends="copyDeployFiles,agent,__extract_testbox,addExtensions,addMavenDependencies,addBundles,__build_single">
    <echots message="done, the archives, extensions and bundles are in ${outputDir}"/>
  </target>

  <target name="__build_single">
    <echots message="copy bundles in place"/>
    <addBundles
      bundles="${dependencies}"
      target="${temp}/archive/base/lucee-server/bundles"
      coremanifest="${coreManifest}"/>

    <echots message="copy extensions in place"/>
    <copyExtensions
      source="${cache}"
      target="${temp}/archive/base/lucee-server/context/extensions/available"
      extensions="${reqExt.data}">
    </copyExtensions>

    <echots message="build the archives with Lucee itself (${outputDir})"/>
    <java classname="org.apache.tools.ant.launch.Launcher" dir="${ant}" fork="true" failonerror="false" errorproperty="exc" resultproperty="exitcode">
      <classpath path="${java.class.path}">
          <pathelement location="${outputDir}"/>
          <pathelement path="${runtime_classpath}"/>
      </classpath>

      <arg value="-f"/>
      <arg value="${ant}/build-create-archive.xml"/>

      <jvmarg value="-Dsrc=${tmpContext}"/>
      <jvmarg value="-Dtemp=${temp}/archive"/>
      <jvmarg value="-Dtestbox=${temp}/testbox/testbox"/>
      <jvmarg value="-DcompileTestBox=${compileTestBox}"/>
      <jvmarg value="-Dlucee.base.dir=${temp}/archive/base"/>
      <jvmarg value="-Dlucee.web.dir=${temp}/archive/webroot"/>
      <jvmarg value="-Dlucee.enable.dialect=true"/>
      <jvmarg value="-Dlucee.extensions.install=true"/>
      <jvmarg value="-Dlucee.full.null.support=false"/>
      <jvmarg value="-Dlucee.enable.bundle.download=true"/>
      <jvmarg value="-Dlucee.cli.printExceptions=true"/>
      <jvmarg value="-Dlucee.ssl.checkserveridentity=false"/>
      <jvmarg value="-Dlucee.compiler.java.version=${javaVersionCoreDefault}"/>
    </java>
    <echo level="error" message="Exit code: ${exitcode}"/>
    <echo level="error" message="Error output: ${exc}"/>
    <fail message="Archive creation failed with exit code ${exitcode}">
      <condition>
        <not><equals arg1="${exitcode}" arg2="0"/></not>
      </condition>
    </fail>

    <echots message="copy the generated archives in place"/>
    <copy file="${temp}/archive/lucee-context.lar" tofile="${outputDir}/resource/context/lucee-context.lar"/>
    <copy file="${temp}/archive/lucee-admin.lar" tofile="${outputDir}/resource/context/lucee-admin.lar"/>
    <copy file="${temp}/archive/lucee-doc.lar" tofile="${outputDir}/resource/context/lucee-doc.lar"/>
    <copy file="${temp}/archive/config-schema.json" tofile="${trgLoader}/config-schema.json"/>
    <copy file="${temp}/archive/env-vars.json" tofile="${trgLoader}/env-vars.json"/>
  </target>
</project>
