<scriptdef name="readRequiredExtensions" language="javascript" classpath="${nashorn_classpath}">
	<attribute name="file" />
	<![CDATA[
		project.log("--- Read Require-Extension from "+attributes.get( "file" )+" ---");
		var filename = attributes.get( "file" );
		var manifest = new java.util.jar.Manifest( new java.io.FileInputStream( new java.io.File( filename ) ) );
		var attrs = manifest.getMainAttributes();
		var str = attrs.getValue( "Require-Extension" );
		project.log("--- RAW ---");
		project.log(str);
		project.log("------");
		var arr = str.split( "," );
		var count = 0;
		var ids = "";
		var data = "";
		var versions = "";
		var labels = "";
		for (var i = 0 ; i < arr.length ; i++ ) {
			var line = arr[ i ];
			project.log("- "+line);
			var extArr = line.split( ';' );
			
			if ( extArr.length < 1 ) 
				continue;
			count++;
			// the first is the id
			if ( ids.length >0 )
				ids += ",";
			ids += extArr[ 0 ];
			if ( data.length > 0 )
				data+=",";
			var strGAV = extArr[ 0 ];
			var _id = extArr[ 0 ];
			
			project.setProperty( "reqExt.ID" + ( i + 1 ), _id );

			// the rest has names
			var _version="";
			var _name="";
			var group="";
			var groupPath="";
			var artifact="";

			// GAV
			var gav = strGAV.split( ':' );
			if ( gav.length > 2 ) {
				_name=gav[1].trim();
				group=gav[0].trim();
				groupPath=group.replace('.','/');
				artifact=gav[1].trim();
				_id = group+"-"+artifact;
				var names=_name.split( '-' );
				if(names.length>1) {
					var tmp="";
					for(var x=0;x<names.length;x++) {
						tmp+=names[x][0].toUpperCase()+names[x].substring(1);
					}
					_name=tmp;
				}

				_version=gav[2].trim();
			}
			data += _id+"-"+_version;

			if(extArr.length>1) {
				for (var y = 1; y < extArr.length ; y++ ) {
					var ext = extArr[ y ];
					var index = ext.indexOf( '=' );
					if ( index == -1 ) 
						continue;
					var name = ext.substring( 0, index ).trim();
					var value = ext.substring( index + 1 ).trim();
					if ( name == "version" ) {
						if ( versions.length > 0)
							versions += ",";
						versions += value;
						data += ";" + value;
						_version = value;
					}
					if ( name == "label" ) {
						if( labels.length > 0)
							labels += ",";
						labels += value;
					} else if ( name == "name" ) {
						_name = value;
					}
					project.setProperty( "reqExt." + name + ( i + 1 ), value );
				}
			}


			project.log("ext" + _name + " = "+ _version);
			project.log(_id);
			
			project.setProperty( "reqExt." + _name, _version );
			project.setProperty( "ext" + _name + "Version", _version );
			project.setProperty( "ext" + _name + "Artifact", artifact );
			project.setProperty( "ext" + _name + "Group", group );
			project.setProperty( "ext" + _name + "GroupPath", groupPath );
			project.setProperty( "ext" + _name, _id );
		}
		project.setProperty( "reqExt.length", count + "" );
		project.setProperty( "reqExt.ids", ids );
		project.setProperty( "reqExt.versions", versions );
		project.setProperty( "reqExt.labels", labels );
		project.setProperty( "reqExt.data", data );

		//
	]]>
	</scriptdef>
