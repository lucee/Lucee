    <repository>
      <id>ossrh</id>
      <url>https://central.sonatype.com/api/v1/publisher/upload</url>
    </repository>
    <snapshotRepository>
      <id>ossrh</id>
      <url>https://ossrh-staging-api.central.sonatype.com/content/repositories/snapshots/</url>
    </snapshotRepository>
  </distributionManagement> -->

</project>